# Lady Rabi'a Academy — Environment Variables
# Copy this file to .env (local development) or .env.local and fill in real values.
# NEVER commit .env or .env.local to git.

# ═══════════════════════════════════════════════
# Supabase (required)
# ═══════════════════════════════════════════════
SUPABASE_URL=https://swapiobhcpgufihykoqx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ═══════════════════════════════════════════════
# Supabase Edge Functions (optional)
# ═══════════════════════════════════════════════
SUPABASE_FUNCTIONS_URL=https://swapiobhcpgufihykoqx.supabase.co/functions/v1
ZULIP_CHAT_FUNCTION_NAME=zulip-chat-v2

# ═══════════════════════════════════════════════
# Outseta Authentication (required for production)
# ═══════════════════════════════════════════════
OUTSETA_DOMAIN=your-subdomain.outseta.com
OUTSETA_API_KEY=your_outseta_api_key_here
OUTSETA_WEBHOOK_SECRET=your_outseta_webhook_secret_here

# ═══════════════════════════════════════════════
# Zulip Chat (optional — only if using API integration)
# ═══════════════════════════════════════════════
ZULIP_ORG_URL=https://your-org.zulipchat.com
ZULIP_BOT_API_KEY=your_zulip_bot_api_key_here

# ═══════════════════════════════════════════════
# Brevo Email Service (for newsletters, promos, content alerts)
# ═══════════════════════════════════════════════
BREVO_API_KEY=your_brevo_api_key_here
BREVO_MCP_API_KEY=your_brevo_mcp_api_key_here
BREVO_SENDER_EMAIL=hello@ladyrabiaacademy.com
BREVO_SENDER_NAME=Lady Rabi'a Academy

# ═══════════════════════════════════════════════
# Email Notifications (optional — legacy Resend)
# ═══════════════════════════════════════════════
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=hello@yourdomain.com

# ═══════════════════════════════════════════════
# Site Configuration
# ═══════════════════════════════════════════════
PUBLIC_SITE_URL=https://your-domain.vercel.app
